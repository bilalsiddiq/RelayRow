# ── XE-MAILBOX environment ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values from your Supabase project.

# Supabase project — from Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Edge function environment (set in Supabase Dashboard → Edge Functions) ──
# These are NOT used by the frontend; they're listed here for reference.
#
# SUPABASE_URL          — set automatically by Supabase
# SUPABASE_ANON_KEY     — set automatically by Supabase
# SUPABASE_SERVICE_ROLE_KEY — set automatically by Supabase
#
# INBOX_ADMIN_RPC       — the RPC that answers "is this user staff?"
#                         Default: inbox_is_staff (matches our bindings)
#
# INBOX_SCANNER_GATEWAY — the LLM gateway URL, or 'off' to disable
#                         Default: off (XE-MAILBOX has no host AURA gateway)
#
# INBOX_SCANNER_FEATURE — the gateway feature ID for billing
#                         Default: inbox_scanner
